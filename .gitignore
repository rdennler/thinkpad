envs/*
!envs/.gitkeep
media/*
!media/.gitkeep
tracker/*
!tracker/.gitkeep
memory/*
!memory/.gitkeep

# local Claude Code settings
.claude/settings.local.json

# IDE files
.idea/
.vscode/
